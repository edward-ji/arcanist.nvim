{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "remarkup",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_block"
          },
          {
            "type": "SYMBOL",
            "name": "_blank_line"
          }
        ]
      }
    },
    "_blank_line": {
      "type": "STRING",
      "value": "\n"
    },
    "_block": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "atx_header"
        },
        {
          "type": "SYMBOL",
          "name": "setext_header"
        },
        {
          "type": "SYMBOL",
          "name": "divider"
        },
        {
          "type": "SYMBOL",
          "name": "fenced_code_block"
        },
        {
          "type": "SYMBOL",
          "name": "indented_code_block"
        },
        {
          "type": "SYMBOL",
          "name": "literal_block"
        },
        {
          "type": "SYMBOL",
          "name": "table"
        },
        {
          "type": "SYMBOL",
          "name": "blockquote"
        },
        {
          "type": "SYMBOL",
          "name": "callout"
        },
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "embed_block"
        },
        {
          "type": "SYMBOL",
          "name": "paragraph"
        }
      ]
    },
    "atx_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "marker",
          "content": {
            "type": "SYMBOL",
            "name": "_atx_marker"
          }
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_line_text"
            },
            "named": true,
            "value": "text"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_atx_marker"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "_atx_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "=+"
        }
      }
    },
    "setext_header": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "content",
            "content": {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_line_text"
              },
              "named": true,
              "value": "text"
            }
          },
          {
            "type": "STRING",
            "value": "\n"
          },
          {
            "type": "FIELD",
            "name": "underline",
            "content": {
              "type": "TOKEN",
              "content": {
                "type": "PREC",
                "value": 3,
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "REPEAT1",
                      "content": {
                        "type": "STRING",
                        "value": "="
                      }
                    },
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "-"
                        },
                        {
                          "type": "STRING",
                          "value": "-"
                        },
                        {
                          "type": "STRING",
                          "value": "-"
                        },
                        {
                          "type": "REPEAT",
                          "content": {
                            "type": "STRING",
                            "value": "-"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    },
    "divider": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 3,
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "-"
                },
                {
                  "type": "STRING",
                  "value": "-"
                },
                {
                  "type": "STRING",
                  "value": "-"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "STRING",
                    "value": "-"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "fenced_code_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "```"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "info",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\\n]+"
                },
                "named": true,
                "value": "info_string"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "REPEAT1",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_code_line"
                  }
                },
                "named": true,
                "value": "code_content"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "```"
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "_code_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^\\n`][^\\n]*"
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "indented_code_block": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "  "
            },
            {
              "type": "PATTERN",
              "value": "[^\\n]*"
            },
            {
              "type": "STRING",
              "value": "\n"
            }
          ]
        }
      }
    },
    "literal_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "%%%"
        },
        {
          "type": "STRING",
          "value": "\n"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "REPEAT1",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "PATTERN",
                        "value": "[^\\n]*"
                      },
                      {
                        "type": "STRING",
                        "value": "\n"
                      }
                    ]
                  }
                },
                "named": true,
                "value": "literal_content"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "%%%"
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "blockquote": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ">"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "ALIAS",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_line_text"
                  },
                  "named": true,
                  "value": "text"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "STRING",
              "value": "\n"
            }
          ]
        }
      }
    },
    "callout": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "type",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": 2,
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "NOTE:"
                  },
                  {
                    "type": "STRING",
                    "value": "WARNING:"
                  },
                  {
                    "type": "STRING",
                    "value": "IMPORTANT:"
                  },
                  {
                    "type": "STRING",
                    "value": "(NOTE)"
                  },
                  {
                    "type": "STRING",
                    "value": "(WARNING)"
                  },
                  {
                    "type": "STRING",
                    "value": "(IMPORTANT)"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_line_text"
              },
              "named": true,
              "value": "text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "list": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "list_item"
        }
      }
    },
    "list_item": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "marker",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_indented_marker"
            },
            "named": true,
            "value": "marker"
          }
        },
        {
          "type": "STRING",
          "value": " "
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "checkbox",
              "content": {
                "type": "SYMBOL",
                "name": "checkbox"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_line_text"
            },
            "named": true,
            "value": "text"
          }
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "_indented_marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": " *"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "-+"
                },
                {
                  "type": "PATTERN",
                  "value": "\\*+"
                },
                {
                  "type": "PATTERN",
                  "value": "#+"
                },
                {
                  "type": "PATTERN",
                  "value": "\\d+[.)]"
                }
              ]
            }
          ]
        }
      }
    },
    "checkbox": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "X"
            },
            {
              "type": "STRING",
              "value": "x"
            },
            {
              "type": "STRING",
              "value": " "
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": " "
        }
      ]
    },
    "table": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "table_row"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "table_delimiter_row"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "table_row"
            }
          }
        ]
      }
    },
    "table_row": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "cell",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_table_cell_text"
                },
                "named": true,
                "value": "table_cell"
              }
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "|"
                  },
                  {
                    "type": "FIELD",
                    "name": "cell",
                    "content": {
                      "type": "ALIAS",
                      "content": {
                        "type": "SYMBOL",
                        "name": "_table_cell_text"
                      },
                      "named": true,
                      "value": "table_cell"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "|"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "_table_cell_text": {
      "type": "PATTERN",
      "value": "[^|\\n]+"
    },
    "table_delimiter_row": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": "[ \\t]*-+[ \\t]*"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "|"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[ \\t]*-+[ \\t]*"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "|"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "embed_block": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "embed"
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    },
    "paragraph": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_line_text"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "\n"
                },
                {
                  "type": "SYMBOL",
                  "name": "_line_text"
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\n"
          }
        ]
      }
    },
    "_line_text": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_inline_elt"
      }
    },
    "_inline_elt": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "bold"
        },
        {
          "type": "SYMBOL",
          "name": "italic"
        },
        {
          "type": "SYMBOL",
          "name": "monospace"
        },
        {
          "type": "SYMBOL",
          "name": "monospace_alt"
        },
        {
          "type": "SYMBOL",
          "name": "strikethrough"
        },
        {
          "type": "SYMBOL",
          "name": "underline"
        },
        {
          "type": "SYMBOL",
          "name": "highlighted"
        },
        {
          "type": "SYMBOL",
          "name": "wiki_link"
        },
        {
          "type": "SYMBOL",
          "name": "md_link"
        },
        {
          "type": "SYMBOL",
          "name": "angle_url"
        },
        {
          "type": "SYMBOL",
          "name": "bare_url"
        },
        {
          "type": "SYMBOL",
          "name": "mention"
        },
        {
          "type": "SYMBOL",
          "name": "project_tag"
        },
        {
          "type": "SYMBOL",
