        },
        {
          "type": "SYMBOL",
          "name": "embed"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "bold": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
